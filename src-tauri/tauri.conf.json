{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KlikReel",
  "version": "0.1.17",
  "identifier": "com.ashafizullah.klikreel",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KlikReel",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["script-src", "style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/projects/*/media/**",
          "$CACHE/klikreel/thumbs/**",
          "$CACHE/klikreel/voice-preview/**",
          "$TEMP/klikreel/thumbs/**",
          "$TEMP/klikreel/voice-preview/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Free, open-source AI promo video maker",
    "copyright": "Copyright © 2026 Adam Suchi Hafizullah. MIT License.",
    "publisher": "KlikReel contributors",
    "homepage": "https://github.com/ashafizullah/klikreel",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 210
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": {
        "recommends": [
          "ffmpeg",
          "chromium"
        ]
      },
      "rpm": {
        "recommends": [
          "ffmpeg",
          "chromium"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMTAwQUY1Q0QwOTA3NEMKUldSTUJ3bk45UW9RczBRSGhidG44TGFvL2k1aGZPUmNrUE5halpDemRGQ1lUeDVjSDMrNVNpVjEK",
      "endpoints": [
        "https://github.com/ashafizullah/klikreel/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

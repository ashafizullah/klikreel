{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KlikReel",
  "version": "0.1.0",
  "identifier": "com.ashafizullah.aivideoeditor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KlikReel",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Free, open-source AI promo video maker",
    "copyright": "MIT License",
    "publisher": "KlikReel contributors",
    "homepage": "https://github.com/ashafizullah/klikreel",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 210
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": {
        "recommends": [
          "ffmpeg",
          "chromium"
        ]
      },
      "rpm": {
        "recommends": [
          "ffmpeg",
          "chromium"
        ]
      }
    }
  }
}
